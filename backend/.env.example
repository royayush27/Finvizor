# Copy this file to .env and fill in real values. Never commit .env.
#
# FRED (economic data): https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# NewsAPI.org (news sentiment filtering): https://newsapi.org/
NEWS_API_KEY=

# NAVER CLOVA Studio (optional AI portfolio summary, Korean-language):
# https://www.ncloud.com/product/aiService/clovaStudio
NAVER_CLOVA_API_KEY=

# Comma-separated list is NOT supported here directly -- edit
# app/core/config.py's default if you need more than the Next.js dev origin.
